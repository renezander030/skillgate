{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/renezander030/skillgate/master/schema/done.schema.json",
  "title": "skillgate definition-of-done",
  "description": "Schema for .skillgate/done.yaml — deterministic finish-line gates.",
  "type": "object",
  "required": ["gates"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Spec format version. Omit for the current format."
    },
    "name": {
      "type": "string",
      "description": "A label for this definition of done."
    },
    "finishLine": {
      "type": "array",
      "description": "Commands that count as crossing the finish line. Patterns are matched structurally against shell command segments.",
      "items": { "type": "string", "minLength": 1 }
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum wall-clock budget in milliseconds for the complete gate run. Default 300000."
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/gate" }
    }
  },
  "definitions": {
    "when": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Conditions under which the gate applies (all must hold). An undecidable condition runs the gate.",
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Finish-line command prefixes this gate is required for." },
        "changed": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Run only if a file matching one of these globs changed versus the base ref." },
        "branch": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Run only on a branch matching one of these globs." }
      }
    },
    "base": {
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id"]
    },
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "file"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "file-exists" },
            "file": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ],
              "description": "Path or paths that must all exist."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "file", "pattern"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "file-contains" },
            "file": { "type": "string" },
            "pattern": { "type": "string", "description": "JavaScript regular expression source." },
            "flags": { "type": "string", "description": "Regex flags, e.g. \"i\"." },
            "maxBytes": { "type": "integer", "minimum": 1, "description": "Largest file (bytes) the gate reads; larger files fail it. Default 10485760 (10 MiB)." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "glob", "pattern"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "absent" },
            "glob": { "type": "string", "description": "Files to scan." },
            "pattern": { "type": "string", "description": "Regex that must NOT appear." },
            "flags": { "type": "string" },
            "ignore": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra globs to exclude (fixtures, examples, the spec itself)."
            },
            "maxBytes": { "type": "integer", "minimum": 1, "description": "Largest file (bytes) the gate reads; larger files fail it. Default 10485760 (10 MiB)." },
            "allowEmpty": { "type": "boolean", "description": "Allow the glob to match no files. Default false: a glob matching nothing fails as a no-op." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "run"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "command" },
            "run": { "type": "string", "description": "Shell command; must exit 0." },
            "timeout": { "type": "integer", "minimum": 1, "description": "Timeout in milliseconds. Default 30000." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "trivy" },
            "target": { "type": "string", "description": "Path to scan. Default \".\"." },
            "trivy": { "type": "string", "description": "Trivy binary to execute. Default \"trivy\"." },
            "scanners": {
              "type": "array",
              "items": { "enum": ["vuln", "secret"] },
              "description": "Trivy scanners to run. Default [\"vuln\", \"secret\"]."
            },
            "severity": {
              "type": "array",
              "items": { "enum": ["UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
              "description": "Vulnerability severities that block. Default [\"CRITICAL\"]."
            },
            "sbom": {
              "type": "boolean",
              "description": "Also require Trivy to generate a CycloneDX SBOM. Default true."
            },
            "ignoreUnfixed": {
              "type": "boolean",
              "description": "Pass --ignore-unfixed to the vulnerability scan. Default false."
            },
            "timeout": { "type": "integer", "minimum": 1, "description": "Timeout in milliseconds per Trivy invocation. Default 30000." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "file"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "evidence" },
            "file": { "type": "string", "description": "A file that must exist and be non-empty." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "instruction-sync" },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Similarity required to count as in sync (default 0.95)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "not-empty" },
            "path": { "type": "string", "description": "Directory path that must contain at least `min` entries." },
            "min": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum number of entries. Default 1."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "glob", "pattern"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "no-new" },
            "glob": { "type": "string", "description": "Files to scan." },
            "pattern": { "type": "string", "description": "Regex whose match count must not increase versus the base ref." },
            "flags": { "type": "string" },
            "ignore": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra globs to exclude."
            },
            "maxBytes": { "type": "integer", "minimum": 1, "description": "Largest file (bytes) the gate reads; larger files fail it. Default 10485760 (10 MiB)." },
            "allowEmpty": { "type": "boolean", "description": "Allow the glob to match no files. Default false: a glob matching nothing fails as a no-op." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "glob"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "no-deleted" },
            "glob": { "type": "string", "description": "Files that existed at the base ref and must still exist." },
            "ignore": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra globs to exclude from the must-still-exist set."
            },
            "allowEmpty": { "type": "boolean", "description": "Allow the glob to match no files. Default false: a glob matching nothing fails as a no-op." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "glob", "pattern"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "no-fewer" },
            "glob": { "type": "string", "description": "Files to scan." },
            "pattern": { "type": "string", "description": "Regex whose match count must not decrease versus the base ref (test cases, assertions)." },
            "flags": { "type": "string" },
            "ignore": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra globs to exclude."
            },
            "maxBytes": { "type": "integer", "minimum": 1, "description": "Largest file (bytes) the gate reads; larger files fail it. Default 10485760 (10 MiB)." },
            "allowEmpty": { "type": "boolean", "description": "Allow the glob to match no files. Default false: a glob matching nothing fails as a no-op." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string" },
            "description": { "type": "string" },
            "when": { "$ref": "#/definitions/when" },
            "type": { "const": "deps-locked" },
            "manifest": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              ],
              "description": "package.json or pyproject.toml path(s). Default: every supported manifest at the workspace root."
            }
          }
        }
      ]
    }
  }
}
